# Build used by the browser suite (vite build --mode e2e).
# The relayer at this address is served by the suite itself (Playwright routes),
# with fixed answers. The indexer and Ethereum RPC are switched off, so every
# page is exercised in the state where it must say plainly what it cannot read.
VITE_NETWORK_ID=undeployed
VITE_RELAYER_URL=http://127.0.0.1:3299
VITE_INDEXER_URL=off
VITE_EVM_RPC_URL=off
VITE_NIGHTKIT_VAULT_URL=http://127.0.0.1:5184
