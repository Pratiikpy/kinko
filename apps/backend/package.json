{
  "name": "@kinko/backend",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Kinko's merchant backend: API keys, hosted checkout sessions, signed webhooks, a chain watcher, the conversion oracle signer and the assistant endpoint. Never holds a private key, a witness or an amount it was not given.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --experimental-transform-types --disable-warning=ExperimentalWarning src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@kinko/kinko-pay": "workspace:*",
    "@midnight-ntwrk/compact-runtime": "0.21.0",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@kinko/bot": "workspace:*",
    "@kinko/cli": "workspace:*",
    "@kinko/mcp": "workspace:*",
    "@kinko/node": "workspace:*",
    "@midnightntwrk/ledger-v9": "1.0.1",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
