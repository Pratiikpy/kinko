# Copy to .env and fill in. See README.md for what each value does.

# Required.
# openssl rand -hex 32
KINKO_DATA_KEY=
# The deployed kinko_pay contract address, 64 hex characters.
KINKO_PAY_ADDRESS=

# Midnight indexer. The defaults target the local docker stack.
KINKO_INDEXER_URL=http://localhost:8088/api/v4/graphql
# KINKO_INDEXER_WS_URL=

# Where the web app lives, for hosted checkout and bot links.
KINKO_APP_URL=http://localhost:5173
# KINKO_APP_INVOICE_PATH=/app/invoices

KINKO_HOST=127.0.0.1
KINKO_PORT=3100
KINKO_DB_PATH=./data/kinko.db

# Cross-origin access: a comma-separated list of origins, or *.
# KINKO_CORS_ORIGINS=http://localhost:5173
# KINKO_TRUST_PROXY=false

# Restrict who may register as a merchant (16 characters or more).
# KINKO_REGISTRATION_TOKEN=

# The Telegram bot's service token (32 characters or more); the bot is given the same value.
# KINKO_BOT_TOKEN=

# The conversion oracle. The key must be the one sealed into kinko_pay.
# KINKO_ORACLE_SECRET_KEY=
# A fixed rate, or a price feed, not both. The feed below is NIGHT's live USD price;
# KUSD is one USD of USDC held by the vault.
# KINKO_ORACLE_KUSD_PER_NIGHT=
# KINKO_ORACLE_RATE_URL=https://api.coingecko.com/api/v3/simple/price?ids=midnight-3&vs_currencies=usd
# KINKO_ORACLE_RATE_PATH=midnight-3.usd
# How long a quote stays valid. Ten minutes covers proving on a slow device; the price is
# rounded up to a cent, so the merchant never receives less.
# KINKO_ORACLE_QUOTE_TTL_SECONDS=600

# The assistant. Without a key its endpoint answers 503.
# KINKO_ASSISTANT_API_KEY=
# KINKO_ASSISTANT_MODEL=gemini-2.5-flash

# Development only: allow http and private-network webhook targets.
# KINKO_ALLOW_PRIVATE_WEBHOOKS=false

# KINKO_POLL_MS=5000
# KINKO_LATE_SETTLEMENT_DAYS=14
# KINKO_SESSION_TTL_SECONDS=3600
# KINKO_LOG_LEVEL=info
