{
  "name": "@kinko/bot",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Kinko's Telegram bot for merchants: link an account, list invoices, create payment links and get a message when one settles. Talks only to the Kinko backend and never holds a key.",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "kinko-bot": "./src/index.ts"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --experimental-transform-types --disable-warning=ExperimentalWarning src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "exports": {
    "./*": "./src/*.ts"
  }
}
