# Kinko relayer. Copy to .env, fill in, and run `yarn workspace @kinko/relayer start`
# (or point RELAYER_ENV_FILE at the file). Every variable is validated at startup and
# every problem is reported at once.

# --- Midnight (the same variables the deploy tooling reads) ---
# undeployed | stagenet | preview | preprod | mainnet. Defaults to undeployed, the local
# docker stack. Endpoint overrides: MIDNIGHT_NODE_URL, MIDNIGHT_NODE_INDEXER_URL,
# MIDNIGHT_NODE_INDEXER_WS_URL, MIDNIGHT_NODE_PROOF_SERVER_URL. The proof server stays
# local: it sees every witness.
NETWORK_ID=

# The relayer's OWN wallet seed (hex or mnemonic). It pays the Midnight fees (DUST) for
# every flush, send and attestation it submits. Fund it with NIGHT; the relayer registers
# the NIGHT for DUST generation at startup. It holds no user key and cannot move user funds.
RELAYER_SEED=

# Where the relayer wallet's cache lives, so a restart resumes its sync instead of replaying
# the chain. Unset, the deploy SDK keeps it as .wallet-cache-<network>-relayer-<id>.json in
# the repository root (the nearest directory holding .git), and syncs from scratch when there
# is none. A cache that does not match this wallet and chain is refused: at the default path
# it is deleted and the wallet resyncs, at a path named here the relayer refuses to start.
RELAYER_WALLET_CACHE_PATH=

# The deployed vault and the signet responder the MPC posts its responses to (bare hex).
# The responder defaults to the one the SDK publishes for preview and preprod, and a set
# value must agree with it there; elsewhere it is required.
MIDNIGHT_VAULT_CONTRACT_ADDRESS=
MIDNIGHT_RESPONDER_CONTRACT_ADDRESS=

# --- Ethereum ---
EVM_RPC_URL=
# The chain id the vault was initialised with. The relayer refuses to start if it differs.
EVM_CHAIN_ID=
# The USDC contract the vault backs the dollar with. /backing reads its balance of the vault.
USDC_ADDRESS=
# The MPC network's secp256k1 public key (SEC1 hex). It derives every deposit address; the
# relayer refuses to start if it does not derive the vault's own account.
MPC_SECP256K1_PUBKEY=

# --- HTTP ---
RELAYER_HOST=127.0.0.1
RELAYER_PORT=3200
# Comma-separated origins allowed to call the API from a browser, or *. Empty allows none.
RELAYER_CORS_ORIGINS=
# Requests one client address may make per minute.
RELAYER_RATE_LIMIT_PER_MINUTE=120
# true only behind a proxy you control that sets X-Forwarded-For; otherwise a client could
# name its own address and dodge the limit.
RELAYER_TRUST_PROXY=false

# --- State and behaviour ---
RELAYER_STATE_FILE=relayer-state.json
RELAYER_POLL_INTERVAL_MS=3000
# How long a request may wait in one stage before it is failed. Sized for a live MPC that
# attests after Ethereum finality (about 13 minutes on Sepolia).
RELAYER_STAGE_TIMEOUT_MS=1500000
RELAYER_MAX_CONSECUTIVE_FAILURES=8
# A broadcast transaction that has not mined by then is submitted again.
RELAYER_REBROADCAST_INTERVAL_MS=300000
# true: also flush and send other users' queued deposits and withdrawals, which a withdrawal
# needs (its request id exists only after a flush). false: serve only requests registered
# through POST /requests.
RELAYER_SERVE_UNREGISTERED=true
RELAYER_RETENTION_MS=604800000
RELAYER_BACKING_CACHE_MS=15000

# --- Optional gas top-up (leave RELAYER_EVM_PRIVATE_KEY empty to disable) ---
# A deposit's sweep is sent from the user's deposit address and needs ETH there. With a key
# set, the relayer sends a deposit address exactly the shortfall of its sweep's gas ceiling.
#
# TRUST: this key spends real ETH on behalf of strangers. Anyone who can queue a deposit
# can make the relayer fund the address that deposit derives, so the limits below are the
# whole defence: the most the account can lose to others' sweeps in a day is
# RELAYER_GAS_MAX_PER_DAY_WEI, and the most one address can ever draw is
# RELAYER_GAS_MAX_PER_ADDRESS_WEI. Fund the account with little more than the daily limit.
# The key never touches Midnight, USDC or any user's key, and only deposits are funded
# (a withdrawal is paid from the vault's own account).
RELAYER_EVM_PRIVATE_KEY=
RELAYER_GAS_MAX_PER_ADDRESS_WEI=
RELAYER_GAS_MAX_PER_DAY_WEI=
