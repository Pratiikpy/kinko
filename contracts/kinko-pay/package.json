{
  "name": "@kinko/kinko-pay",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Kinko's payment contracts on Midnight: invoices, batch payments, receipts, gift cards, the PIN card and tags, settled in the vault's KUSD token.",
  "exports": {
    ".": "./src/index.ts",
    "./managed/*": "./src/managed/*"
  },
  "scripts": {
    "compile": "sh scripts/compile.sh",
    "compile:zk": "sh scripts/compile.sh --zk",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@kinko/card": "workspace:*",
    "@midnight-ntwrk/compact-runtime": "0.21.0",
    "@midnightntwrk/ledger-v9": "1.0.1",
    "@midnightntwrk/wallet-sdk-address-format": "4.0.0"
  },
  "devDependencies": {
    "@midnightntwrk/onchain-runtime-v4": "4.0.1",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
